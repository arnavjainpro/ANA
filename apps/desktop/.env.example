# Desktop renderer flags (Vite — only VITE_-prefixed vars reach the renderer).
# Secrets never live here; those stay in the backend .env.

# Controls how Ana enters the Tavus call:
#   true  (default) → show a "Start Ana" button; the call begins on click.
#   false           → auto-boot into the call on launch, once GitHub is connected.
# Keep this "true" during development to conserve Tavus/API tokens.
VITE_TAVUS_MANUAL_START=true
