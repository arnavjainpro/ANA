ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVUS_API_KEY=
TAVUS_REPLICA_ID=
TAVUS_PERSONA_ID=
# Public HTTPS URL where Tavus can reach THIS backend. Tavus runs in the cloud
# and cannot call http://localhost, so when this is set the persona's LLM layer
# is pointed at <ANA_PUBLIC_URL>/v1/chat/completions and Ana speaks via our own
# streaming, RAG-grounded backend (she can talk about the user's code). Leave it
# blank to fall back to Tavus's native hosted LLM (works, but no codebase access).
# Dev: run a tunnel, e.g. `ngrok http 8787`, and paste the https URL here.
ANA_PUBLIC_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
JWT_SECRET=
PORT=
