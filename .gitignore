# Dependencies
node_modules/

# Build output
dist/
dist-electron/
out/
release/
build/

# ...but NOT the Build-mode source panel (the broad `build/` rule above matches it)
!apps/desktop/src/renderer/panels/build/
!apps/desktop/src/renderer/panels/build/**

# Env
.env
.env.local
*.env
!.env.example
# Desktop renderer flags only — no secrets live here (Vite exposes VITE_* to the
# renderer, so secrets must never go in this file). Tracked for shared defaults.
!apps/desktop/.env

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Misc
*.tsbuildinfo
.cache/
